			gen nwshare_`concept'=value/nwshare  if varcode=="t-hs-dsh-`concept'-ho"
		}
		
		graph bar nwshare_* , stack over(percentile , label(angle(45)))	name(b, replace)
		
		graph combine a b
	
	restore
