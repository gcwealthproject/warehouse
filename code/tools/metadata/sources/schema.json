{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "config",
    "records"
  ],
  "definitions": {
    "record": {
      "type": "object",
      "properties": {
        "shared_citekey_group": {
          "type": "string"
        },
        "shared_citekey_note": {
          "type": "string"
        },
        "is_data_source": {
          "type": "boolean"
        },
        "source_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "legend",
        "citekey",
        "bib"
      ]
    }
  }
}
